{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "cognify",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "backend.app.main:app", "--port", "8000", "--env-file", ".env"],
      "port": 8000
    },
    {
      "name": "cognify-static",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "http.server", "8001", "--directory", "frontend"],
      "port": 8001
    }
  ]
}
